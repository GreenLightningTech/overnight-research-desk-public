# Copy to .env (never commit .env). All keys are free accounts; leave a key empty to skip that source.
# SEC and BLS require a contact User-Agent: your name and email.
SEC_USER_AGENT="Your Name you@example.com"
# https://www.tiingo.com/account/api/token (free)
TIINGO_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=
# https://developer.finra.org (free API credential, Query API)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# Reviewer command (see run/run-review.sh), e.g. a local agent CLI in one-shot mode reading a prompt file
REVIEW_CMD=
